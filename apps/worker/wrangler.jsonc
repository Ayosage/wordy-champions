{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "CLIENT_ORIGIN": "http://localhost:5173", "APP_VERSION": "dev" },
  "durable_objects": { "bindings": [{ "name": "MATCH", "class_name": "WordyMatch" }] },
  // v2 + v3 reset the namespace. Before match-core v0.1.4 the object built its
  // schema in the constructor, so every probe of an unused code, and every room
  // that expired, left an object holding five empty tables that nothing
  // collects. v2 drops the class and every object with it; v3 brings the class
  // straight back, empty. Tags are applied in order in one deploy, and a tag is
  // only ever applied once, so these stay here as history.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WordyMatch"] },
    { "tag": "v2", "deleted_classes": ["WordyMatch"] },
    { "tag": "v3", "new_sqlite_classes": ["WordyMatch"] }
  ],
  // Per-IP abuse guards (src/guards.ts). Creating a room costs a Durable
  // Object, so it is the tight one; the lookup limit is what keeps the
  // four-letter code space from being walked.
  "ratelimits": [
    { "name": "OPEN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LOOKUP_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
