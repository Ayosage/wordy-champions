{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "CLIENT_ORIGIN": "http://localhost:5173", "APP_VERSION": "dev" },
  "durable_objects": { "bindings": [{ "name": "MATCH", "class_name": "WordyMatch" }] },
  // Do not add a `deleted_classes` tag here while the MATCH binding exists.
  // Cloudflare validates the whole deploy before applying anything and rejects
  // it: "Cannot apply --delete-class migration to class 'WordyMatch' without
  // also removing the binding that references it" (code 10061). A later tag
  // recreating the class in the same deploy does not satisfy it. Clearing the
  // namespace needs two deploys, the first with the binding and the export
  // taken out, which means the game is down in between.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WordyMatch"] }],
  // Per-IP abuse guards (src/guards.ts). Creating a room costs a Durable
  // Object, so it is the tight one; the lookup limit is what keeps the
  // four-letter code space from being walked.
  "ratelimits": [
    { "name": "OPEN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LOOKUP_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
